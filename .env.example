# Copy this to .env and fill in values for local development.
#
# EVERY VARIABLE THE CODE ACTUALLY READS IS LISTED HERE. That was not true
# before 2026-08-20 — the code read 65 and this file named 3, so the only way
# to know what a deployment was actually doing was to read the Render dashboard
# against a dozen source files. A variable absent from here used to mean
# nothing; now it means the code does not read it.
#
# Verify this file is still complete:
#   grep -rhoE "process\.env\.[A-Z_][A-Z0-9_]*" src/ server.js migrations/ \
#     | sed 's/process\.env\.//' | sort -u
#
# ⚠ SEVERAL OF THESE SILENTLY TURN REAL CAPABILITY ON AND OFF. They are marked
#   BEHAVIOR SWITCH. Setting or unsetting one changes what the product does for
#   real users, with no other signal. Know what you are changing.

# ── REQUIRED ─────────────────────────────────────────────────────────────
DATABASE_URL=                      # Postgres. Set automatically by docker-compose locally.
ANTHROPIC_API_KEY=
OPERATOR_KEY=                      # The shared operator key. Never put this in a browser.
OPERATOR_APP_ORIGIN=http://localhost:5173

# ── RUNTIME ──────────────────────────────────────────────────────────────
# PORT=3000
# NODE_ENV=development             # UNSET MEANS PRODUCTION. Set development or test to get dev_code from /auth/sms/start and the PROPERTY_OPERATING_TZ_JSON override.
# PGSSL=                           # SSL decision is normally derived — see src/shared/database_ssl.js
# APP_BASE_URL=
# PUBLIC_BASE_URL=
# PUBLIC_APPLY_BASE_URL=
# RENDER_GIT_COMMIT=               # Set by Render. Used to identify the deployed build.

# ── MIGRATION / RELEASE ──────────────────────────────────────────────────
#  A deploy does NOT migrate. prestart VERIFIES and refuses to start on a
#  mismatch. Releasing schema is a separate, deliberate act.
# MIGRATION_RELEASE=               # Must be 1 to allow --apply to write.
# EXPECTED_LEDGER_CEILING=         # Exists so a release cannot be run by someone who has not read the ledger.
# EXPECTED_SHA=                    # Required when releasing against a deployed build.
# MIGRATION_LOCK_TIMEOUT=

# ── TWILIO / SMS ─────────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM_NUMBER=              # ⚠ DOCUMENTED BUT READ BY NOTHING. The sending
#                                  #   number is per-property in the database. Setting
#                                  #   this changes nothing. Kept listed so nobody
#                                  #   sets it believing otherwise.
# SMS_SEND_MODE=                   # BEHAVIOR SWITCH — governs whether outbound SMS actually sends.
# SMS_ALLOW_CREDENTIAL_SENDS=      # BEHAVIOR SWITCH
# SMS_PROOF_CELL=
# SMS_QA_PROPERTY_ID=

# ── PLAID ────────────────────────────────────────────────────────────────
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox

# ── READ AI / MEETING EVIDENCE ───────────────────────────────────────────
#  Both required to activate the webhook. Without them the whole pipeline is
#  dormant — no connection, no webhook, no receipt.
# READ_AI_CONNECTION_ID=00000000-0000-0000-0000-000000000000
# READ_AI_WEBHOOK_SIGNING_KEY=
# MEETING_RECEIPT_MODEL=claude-sonnet-4-6

# ── OUTLOOK / ACUITY SCHEDULING SYNC ─────────────────────────────────────
#  ⚠ The integration exists in source but its mount file is named
#    outlookAcuityMount.example.js and is required by nothing. Setting these
#    does not currently activate anything.
# OUTLOOK_GRAPH_CLIENT_ID=
# OUTLOOK_GRAPH_CLIENT_SECRET=
# OUTLOOK_GRAPH_TENANT_ID=
# OUTLOOK_ACUITY_MAILBOX=
# OUTLOOK_ACUITY_FOLDER_ID=
# OUTLOOK_ACUITY_SYNC_SECRET=
# OUTLOOK_ACUITY_INTEGRATION_KEY=
# OUTLOOK_ACUITY_ALLOWED_SENDER_DOMAINS=
# OUTLOOK_ACUITY_INITIAL_SYNC_AFTER=

# ── ASK SPINE ────────────────────────────────────────────────────────────
# ASK_SPINE_MODEL=
# ASK_SPINE_EFFORT=

# ── AI INGEST / EXTRACTION ───────────────────────────────────────────────
# INGEST_MODEL=
# INGEST_FORCE_PLANNER=
# MAX_INGEST_TOKENS=
# EXTRACT_TOKENS=
# PLAN_TOKENS=
# PLAN_PER_BATCH=

# ── PER-PROPERTY CAPABILITY ALLOWLISTS ───────────────────────────────────
#  ⚠ ALL BEHAVIOR SWITCHES. Each is a comma-separated list of property UUIDs
#    gating a different live capability. Which properties have which capability
#    enabled is knowable ONLY by reading these together — nothing in the repo
#    reports the current set.
# ACTIVATION_PROPERTY_IDS=
# EXECUTED_LEASE_INTAKE_ENABLED=   # BEHAVIOR SWITCH — must be "true" AND the property allowlisted below
# EXECUTED_LEASE_PROPERTY_IDS=     #   Together these gate recording a real executed lease.
# LEASING_INTAKE_PROPERTY_IDS=
# PROSPECT_ACTIVATION_PROPERTY_IDS=
# AGENT_TOUR_BOOKING_PROPERTY_IDS=
# AGENT_AUTO_DISPATCH_PROPERTY_IDS=
# SYNTHETIC_SEED_PROPERTY_IDS=

# ── FEATURE FLAGS ────────────────────────────────────────────────────────
# COMMITMENT_LEDGER_MODE=          # BEHAVIOR SWITCH — doctrine says fail-closed by default.
#                                  #   Production and local have disagreed on this before.
# DEMO_MODE=false                  # BEHAVIOR SWITCH — gates the demo session bootstrap AND a
#                                  #   boot hook that writes durable rent-roll data.
# DEMO_ACCESS_CODE=
# DEMO_BOOKING_ENABLED=false
# DEMO_INTAKE_LIVE_SMS=            # BEHAVIOR SWITCH — demo path sending real SMS.
# SYNTHETIC_SEED_ENABLED=          # BEHAVIOR SWITCH
# LEASING_DESK_SHOW_INTERNAL_QA=
# PROPERTY_OPERATING_TZ_JSON={}

# ── SHARED SECRETS / PUBLIC DOORS ────────────────────────────────────────
# LEASING_INTAKE_SECRET=           # Public lead-intake door.
# INTAKE_ALLOWED_NUMBERS=          # Phone allowlist gating POST /intake/twilio.
# INTAKE_PASSWORD=
# PUBLIC_REVIEW_PASSWORD=
# COMPLIANCE_REFERENCE_SECRET=
