# Copy this to .env and fill in values for local development
# DATABASE_URL is set automatically by docker-compose — do not set it here

ANTHROPIC_API_KEY=
OPERATOR_KEY=
OPERATOR_APP_ORIGIN=http://localhost:5173

# Optional — Read AI Meeting Evidence (both required to activate the webhook)
# READ_AI_CONNECTION_ID=00000000-0000-0000-0000-000000000000
# READ_AI_WEBHOOK_SIGNING_KEY=
# MEETING_RECEIPT_MODEL=claude-sonnet-4-6

# Optional integrations (fail-soft if unset)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox

# Feature flags
# DEMO_MODE=false
# DEMO_BOOKING_ENABLED=false
# PROPERTY_OPERATING_TZ_JSON={}
